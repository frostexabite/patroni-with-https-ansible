#!/usr/bin/env bash
# Refuse to commit vault files that are not encrypted
# Enable with:  git config core.hooksPath scripts/git-hooks
set -euo pipefail

status=0
while IFS= read -r f; do
  [ -f "$f" ] || continue
  if ! head -n1 "$f" | grep -q '^\$ANSIBLE_VAULT;'; then
    echo "ERROR: $f is not encrypted. Run: ansible-vault encrypt $f" >&2
    status=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACM | grep -E '(^|/)vault\.ya?ml$' || true)

# The cluster CA key (inventory/pki/ca.key or inventories/*/pki/ca.key) must always be encrypted
while IFS= read -r f; do
  [ -f "$f" ] || continue
  if ! grep -q 'ENCRYPTED PRIVATE KEY' "$f"; then
    echo "ERROR: $f is an unencrypted private key. Never commit it." >&2
    status=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACM | grep -E '(^|/)pki/.*\.key$' || true)

exit $status
