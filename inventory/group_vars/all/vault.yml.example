# คัดลอกเป็น vault.yml แล้วเข้ารหัสก่อน commit:
#   cp inventory/group_vars/all/vault.yml.example inventory/group_vars/all/vault.yml
#   vi inventory/group_vars/all/vault.yml
#   ansible-vault encrypt inventory/group_vars/all/vault.yml
vault_pg_superuser_password: "ChangeMe-Super-123"
vault_pg_replication_password: "ChangeMe-Repl-123"
vault_pg_rewind_password: "ChangeMe-Rewind-123"
vault_patroni_restapi_password: "ChangeMe-Api-123"
vault_haproxy_stats_password: "ChangeMe-Stats-123"
vault_keepalived_auth_pass: "Kp8chars"   # ไม่เกิน 8 ตัวอักษร
vault_tls_ca_passphrase: "ChangeMe-CA-Key-123"   # เข้ารหัส inventory/pki/ca.key (CA ของ cluster) — ห้ามลืม
