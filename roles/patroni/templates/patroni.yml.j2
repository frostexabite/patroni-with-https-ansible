# {{ ansible_managed }}
{# patroni_tls_stage (ใช้ใน playbooks/enable-tls.yml):
      pg_ssl = เปิด ssl ใน PostgreSQL อย่างเดียวก่อน (REST API / etcd / sslmode ภายในยังเหมือนเดิม)
      final  = ค่าปกติตาม tls_enabled #}
{% set tls_pg = tls_enabled | bool %}
{% set tls_all = tls_enabled | bool and (patroni_tls_stage | default('final')) == 'final' %}
scope: {{ cluster_scope }}
namespace: {{ cluster_namespace }}
name: {{ inventory_hostname }}

log:
  level: INFO

restapi:
  listen: {{ node_ip }}:{{ patroni_restapi_port }}
  connect_address: {{ node_ip }}:{{ patroni_restapi_port }}
  authentication:
    username: {{ patroni_restapi_username }}
    password: {{ patroni_restapi_password | to_json }}
{% if tls_all %}
  # https — HAProxy ตรวจด้วย check-ssl + ca-file; Patroni โหลด cert ใหม่เองตอน reload
  certfile: {{ tls_node_cert }}
  keyfile: {{ tls_postgres_key }}

ctl:
  cacert: {{ tls_ca_cert }}
{% endif %}

etcd3:
{% if tls_all %}
  protocol: https
  cacert: {{ tls_ca_cert }}
  cert: {{ tls_node_cert }}
  key: {{ tls_postgres_key }}
{% endif %}
  hosts:
{% for h in groups['pg_cluster'] %}
    - {{ hostvars[h]['node_ip'] }}:{{ etcd_client_port }}
{% endfor %}

bootstrap:
  dcs:
    {{ patroni_dcs | to_nice_yaml(indent=2) | indent(4) | trim }}
    postgresql:
      use_pg_rewind: true
      use_slots: true
      parameters:
        {{ pg_dcs_parameters | to_nice_yaml(indent=2) | indent(8) | trim }}
  initdb:
    - encoding: UTF8
    - locale: C.UTF-8
    - data-checksums

postgresql:
  listen: 127.0.0.1,{{ node_ip }}:{{ pg_port }}
  connect_address: {{ node_ip }}:{{ pg_port }}
  data_dir: {{ pg_data_dir }}
  bin_dir: {{ pg_bin_dir }}
  pgpass: /var/lib/pgsql/.pgpass_patroni
  authentication:
    superuser:
      username: {{ pg_superuser }}
      password: {{ pg_superuser_password | to_json }}
{% if tls_all %}
      sslmode: {{ tls_postgres_internal_sslmode }}
      sslrootcert: {{ tls_ca_cert }}
{% endif %}
    replication:
      username: {{ pg_replication_user }}
      password: {{ pg_replication_password | to_json }}
{% if tls_all %}
      sslmode: {{ tls_postgres_internal_sslmode }}
      sslrootcert: {{ tls_ca_cert }}
{% endif %}
    rewind:
      username: {{ pg_rewind_user }}
      password: {{ pg_rewind_password | to_json }}
{% if tls_all %}
      sslmode: {{ tls_postgres_internal_sslmode }}
      sslrootcert: {{ tls_ca_cert }}
{% endif %}
  parameters:
    {{ pg_local_parameters | combine(pg_tls_parameters if tls_pg else {}) | to_nice_yaml(indent=2) | indent(4) | trim }}
{% set h = 'hostssl' if (tls_all and tls_postgres_enforce | bool) else 'host  ' %}
  pg_hba:
    - local   all          all                                peer
    - local   replication  all                                peer
    - {{ h }}  all          all          127.0.0.1/32          scram-sha-256
    - {{ h }}  replication  {{ pg_replication_user }}  {{ cluster_network_cidr }}  scram-sha-256
    - {{ h }}  all          all          {{ cluster_network_cidr }}  scram-sha-256
{% for cidr in app_allowed_cidrs | difference([cluster_network_cidr]) %}
    - {{ h }}  all          all          {{ cidr }}  scram-sha-256
{% endfor %}
{% if tls_all and tls_postgres_enforce | bool %}
    # บังคับ SSL: connection TCP ที่ไม่เข้ารหัสถูกปฏิเสธทั้งหมด
    - hostnossl  all  all  0.0.0.0/0  reject
    - hostnossl  all  all  ::/0       reject
{% endif %}

tags:
  nofailover: false
  noloadbalance: false
  clonefrom: false
  nosync: false
