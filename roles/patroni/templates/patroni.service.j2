# {{ ansible_managed }}
[Unit]
Description=Patroni - PostgreSQL HA ({{ cluster_scope }})
Documentation=https://patroni.readthedocs.io/
After=syslog.target network-online.target etcd.service
Wants=network-online.target

[Service]
Type=simple
User=postgres
Group=postgres
ExecStart={{ patroni_venv }}/bin/patroni {{ patroni_config_file }}
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=process
TimeoutSec=30
Restart=on-failure
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
