# {{ ansible_managed }}
{% set s = tls_scheme %}
{% set ip = node_ip %}
{% set stage = etcd_tls_stage | default('final') %}
{% if stage == 'dual1' %}
{%   set peer_listen = ['http://' ~ ip ~ ':' ~ etcd_peer_port, 'https://' ~ ip ~ ':' ~ etcd_peer_port_tmp] %}
{% elif stage == 'dual2' %}
{%   set peer_listen = ['https://' ~ ip ~ ':' ~ etcd_peer_port_tmp, 'https://' ~ ip ~ ':' ~ etcd_peer_port] %}
{% else %}
{%   set peer_listen = [s ~ '://' ~ ip ~ ':' ~ etcd_peer_port] %}
{% endif %}
{% if stage in ['dual1', 'dual2'] %}
{#   etcd can serve http and https on the same port (told apart by the TLS handshake) #}
{%   set client_listen = ['http', 'https'] | product([ip, '127.0.0.1']) | map('join', '://') | map('regex_replace', '$', ':' ~ etcd_client_port) | list %}
{%   set client_adv = 'http' %}
{% else %}
{%   set client_listen = [s ~ '://' ~ ip ~ ':' ~ etcd_client_port, s ~ '://127.0.0.1:' ~ etcd_client_port] %}
{%   set client_adv = s %}
{% endif %}
name: {{ inventory_hostname }}
data-dir: {{ etcd_data_dir }}

listen-peer-urls: {{ peer_listen | join(',') }}
listen-client-urls: {{ client_listen | join(',') }}
initial-advertise-peer-urls: {{ s }}://{{ ip }}:{{ etcd_peer_port }}
advertise-client-urls: {{ client_adv }}://{{ ip }}:{{ etcd_client_port }}

initial-cluster: {% for h in groups['pg_cluster'] %}{{ h }}={{ s }}://{{ hostvars[h]['node_ip'] }}:{{ etcd_peer_port }}{{ '' if loop.last else ',' }}{% endfor %}

initial-cluster-token: {{ etcd_cluster_token }}
initial-cluster-state: new
{% if tls_enabled | bool %}

# mutual TLS: clients (Patroni, etcdctl) and peers must present a certificate signed by the cluster CA
# etcd re-reads certificates on every connection → certificate renewal needs no restart
client-transport-security:
  cert-file: {{ tls_node_cert }}
  key-file: {{ tls_etcd_key }}
  trusted-ca-file: {{ tls_ca_cert }}
  client-cert-auth: true
peer-transport-security:
  cert-file: {{ tls_node_cert }}
  key-file: {{ tls_etcd_key }}
  trusted-ca-file: {{ tls_ca_cert }}
  client-cert-auth: true
tls-min-version: {{ tls_min_protocol | replace('v', '') }}
{% endif %}

auto-compaction-mode: periodic
auto-compaction-retention: "1"
logger: zap
log-level: info
