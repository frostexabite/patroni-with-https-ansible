# {{ ansible_managed }}
global_defs {
    router_id {{ inventory_hostname }}
}

# ตรวจว่า process haproxy ยังรันอยู่ (ไม่ต้องใช้ script/killall)
# weight 0 = ถ้า haproxy ตาย instance จะเข้าสถานะ FAULT และปล่อย VIP ทันที
# (ต้นฉบับใช้ weight 2 ซึ่ง VIP จะไม่ย้าย เพราะ 150 ยังมากกว่า 140+2)
vrrp_track_process track_haproxy {
    process haproxy
    weight 0
    delay 2
}

vrrp_instance VI_PG {
    state {{ 'MASTER' if inventory_hostname == groups['pg_cluster'][0] else 'BACKUP' }}
    interface {{ keepalived_iface }}
    virtual_router_id {{ keepalived_vrid }}
    priority {{ keepalived_priority }}
    advert_int 1
{% if keepalived_unicast | bool %}
    unicast_src_ip {{ node_ip }}
    unicast_peer {
{% for h in groups['pg_cluster'] if h != inventory_hostname %}
        {{ hostvars[h]['node_ip'] }}
{% endfor %}
    }
{% endif %}
    authentication {
        auth_type PASS
        auth_pass {{ keepalived_auth_pass }}
    }
    virtual_ipaddress {
        {{ keepalived_vip }}/{{ keepalived_vip_prefix }} dev {{ keepalived_iface }}
    }
    track_process {
        track_haproxy
    }
}
