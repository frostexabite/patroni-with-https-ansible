# {{ ansible_managed }}
# HAProxy uses the Patroni REST API (port {{ patroni_restapi_port }}) to find the primary/replicas
#   /primary -> 200 only on the leader      (replaces the deprecated /master)
#   /replica -> 200 only on a streaming replica
{% if tls_enabled | bool %}
# TLS: health checks reach Patroni over https (check-ssl) and verify its certificate with the cluster CA
#      ports 5000/5001 are TCP passthrough — application TLS terminates at PostgreSQL itself (node certificate)
{% endif %}
{% set chk = ' check-ssl verify required ca-file ' ~ tls_ca_cert if tls_enabled | bool else '' %}
global
    log stdout format raw local0
    maxconn {{ haproxy_maxconn }}
    user haproxy
    group haproxy
    stats socket /var/lib/haproxy/stats mode 660 level admin
    # the "Reload haproxy" handler saves UP/DOWN state before reloading → the new process does not send writes
    # to replicas while waiting for the first health check (HAProxy otherwise assumes every server is UP)
    server-state-file /var/lib/haproxy/server-state
{% if tls_enabled | bool %}
    ssl-default-bind-options ssl-min-ver {{ tls_min_protocol }}
    ssl-default-server-options ssl-min-ver {{ tls_min_protocol }}
{% endif %}

defaults
    log global
    load-server-state-from-file global
    mode tcp
    option tcplog
    retries 2
    timeout client 30m
    timeout connect 4s
    timeout server 30m
    timeout check 5s

listen stats
    mode http
    bind *:{{ haproxy_stats_port }}{{ (' ssl crt ' ~ tls_haproxy_pem) if tls_enabled | bool else '' }}
    stats enable
    stats uri /
    stats refresh 10s
    # quoted: unquoted, a # in the password starts a comment (the password would be cut at the #)
    stats auth '{{ (haproxy_stats_user ~ ':' ~ haproxy_stats_password) | replace("'", "'\\''") }}'

listen postgres_write
    bind *:{{ haproxy_write_port }}
    option httpchk
    http-check send meth GET uri /primary
    http-check expect status 200
    default-server inter 3s fall 3 rise 2 on-marked-down shutdown-sessions
{% for h in groups['pg_cluster'] %}
    server {{ h }} {{ hostvars[h]['node_ip'] }}:{{ pg_port }} maxconn {{ haproxy_backend_maxconn }} check port {{ patroni_restapi_port }}{{ chk }}
{% endfor %}

listen postgres_read
    bind *:{{ haproxy_read_port }}
    balance roundrobin
    option httpchk
    http-check send meth GET uri {{ haproxy_read_check_uri }}
    http-check expect status 200
    default-server inter 3s fall 3 rise 2 on-marked-down shutdown-sessions
{% for h in groups['pg_cluster'] %}
    server {{ h }} {{ hostvars[h]['node_ip'] }}:{{ pg_port }} maxconn {{ haproxy_backend_maxconn }} check port {{ patroni_restapi_port }}{{ chk }}
{% endfor %}
